---
/**
 * A code sample (the default slot) beside an index of guides it introduces.
 */
interface Props {
  readonly methods: ReadonlyArray<{
    readonly name: string;
    readonly href: string;
    readonly summary: string;
  }>;
}

const { methods } = Astro.props;
---

<div class="method-index not-content">
  <div class="code"><slot /></div>
  <ul>
    {
      methods.map(({ name, href, summary }) => (
        <li>
          <a {href}>{name}</a>
          <span>{summary}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .method-index {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
    margin-top: 1.5rem;
  }

  .code :global(.expressive-code) {
    margin: 0;
  }

  .code :global(p) {
    margin: 1.25rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.65;
  }

  .code :global(p code) {
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
  }

  .code :global(p a) {
    color: var(--sl-color-white);
    text-decoration-color: color-mix(in srgb, var(--sl-color-accent) 70%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }

  ul {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--yl-border);
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--yl-border);
  }

  a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    color: var(--sl-color-accent);
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  @media (max-width: 56rem) {
    .method-index {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>
